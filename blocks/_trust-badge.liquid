

{% liquid
  assign block_settings = block.settings
%}

<div class="trust-badge" {{ block.shopify_attributes }}>
  <span class="trust-badge__icon">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      {%- case block_settings.icon -%}
        {%- when 'coverage' -%}
          <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z"/>
          <circle cx="12" cy="9.5" r="2.5"/>
        {%- when 'payment' -%}
          <rect x="2.5" y="5" width="19" height="14" rx="2"/>
          <path d="M2.5 9.5h19"/>
          <path d="M6 14.5h4"/>
        {%- else -%}
          <circle cx="9" cy="9" r="2"/>
          <path d="M14.5 3h5A1.5 1.5 0 0 1 21 4.5v5a2 2 0 0 1-.6 1.4l-9 9a2 2 0 0 1-2.8 0l-3.5-3.5a2 2 0 0 1 0-2.8l9-9A2 2 0 0 1 14.5 3Z"/>
      {%- endcase -%}
    </svg>
  </span>
  {% if block_settings.heading != blank %}
    <h3 class="trust-badge__heading">{{ block_settings.heading }}</h3>
  {% endif %}
  {% if block_settings.text != blank %}
    <div class="trust-badge__text">{{ block_settings.text }}</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Insignia de confianza",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "Ícono",
      "options": [
        { "value": "coupon", "label": "Cupón" },
        { "value": "coverage", "label": "Cobertura" },
        { "value": "payment", "label": "Métodos de pago" }
      ],
      "default": "coupon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Cupones de descuento"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texto",
      "default": "<p>Agradecemos tu preferencia y no solo eso, ¡también la premiamos!</p>"
    }
  ]
}
{% endschema %}
