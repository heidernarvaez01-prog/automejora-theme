{% doc %}
  Cart upsell carousel: suggests products from the "complementos" collection.
  Quick-add via native AJAX Cart API — no backend of its own.
{% enddoc %}

{% liquid
  assign upsell_collection = collections['complementos']
  assign cart_variant_ids = cart.items | map: 'variant_id'
%}

{% if upsell_collection and upsell_collection.products.size > 0 %}
  <script src="{{ 'cart-upsells.js' | asset_url }}" type="module"></script>

  <cart-upsells-component
    class="cart-upsells spacing-style"
    style="{% render 'spacing-style', settings: block.settings %}"
    {{ block.shopify_attributes }}
  >
    <h3 class="cart-upsells__title">{{ block.settings.heading }}</h3>
    <div class="cart-upsells__track">
      {% for product in upsell_collection.products limit: block.settings.max_products %}
        {% liquid
          assign variant = product.selected_or_first_available_variant
          assign in_cart = false
          if cart_variant_ids contains variant.id
            assign in_cart = true
          endif
        %}
        <div class="cart-upsells__card">
          <a href="{{ product.url }}" class="cart-upsells__media">
            {%- if product.featured_image -%}
              {{ product.featured_image | image_url: width: 300 | image_tag: loading: 'lazy', alt: product.title, width: 150, height: 150 }}
            {%- else -%}
              <span class="cart-upsells__media-placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M20 12v9H4v-9"/>
                  <path d="M2 7h20v5H2z"/>
                  <path d="M12 22V7"/>
                  <path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C10 2 12 7 12 7ZM12 7h4.5a2.5 2.5 0 0 0 0-5C14 2 12 7 12 7Z"/>
                </svg>
              </span>
            {%- endif -%}
          </a>
          <p class="cart-upsells__name">{{ product.title }}</p>
          <p class="cart-upsells__price">{{ variant.price | money }}</p>
          <button
            type="button"
            class="cart-upsells__add{% if in_cart %} cart-upsells__add--added{% endif %}"
            data-variant-id="{{ variant.id }}"
            on:click="/handleAdd"
            {% if in_cart or variant.available == false %}disabled{% endif %}
          >
            {%- if in_cart -%}
              {{- 'icon-checkmark.svg' | inline_asset_content -}}
              <span>Agregado</span>
            {%- elsif variant.available == false -%}
              <span>Agotado</span>
            {%- else -%}
              <span>Añadir</span>
            {%- endif -%}
          </button>
        </div>
      {% endfor %}
    </div>
  </cart-upsells-component>
{% endif %}

{% stylesheet %}
  .cart-upsells {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-block: 24px;
    border-top: 1px solid var(--color-border);
  }

  .cart-upsells__title {
    font-family: var(--font-heading--family);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-foreground-heading);
    margin: 0;
  }

  .cart-upsells__track {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding-bottom: 4px;
    scrollbar-width: thin;
  }

  .cart-upsells__card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 130px;
    flex-shrink: 0;
  }

  .cart-upsells__media {
    display: block;
    aspect-ratio: 1 / 1;
    border-radius: var(--style-border-radius-cards, 8px);
    overflow: hidden;
    background: var(--color-background);
    border: 1px solid var(--color-border);
  }

  .cart-upsells__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-upsells__media-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: var(--color-foreground-muted, var(--color-foreground));
    opacity: 0.4;
  }

  .cart-upsells__media-placeholder svg {
    width: 32px;
    height: 32px;
  }

  .cart-upsells__name {
    margin: 0;
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    color: var(--color-foreground);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-height: 2.2em;
  }

  .cart-upsells__price {
    margin: 0;
    font-family: var(--font-body--family);
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--color-foreground-heading);
  }

  .cart-upsells__add {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: var(--style-border-radius-buttons, 999px);
    border: 1px solid var(--color-primary-button-background);
    background: transparent;
    color: var(--color-primary-button-background);
    font-family: var(--font-body--family);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .cart-upsells__add:hover:not(:disabled) {
    background: var(--color-primary-button-background);
    color: var(--color-primary-button-text);
  }

  .cart-upsells__add:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .cart-upsells__add--added {
    border-color: var(--color-border);
    color: var(--color-foreground-muted, var(--color-foreground));
  }

  .cart-upsells__add--added svg {
    width: 14px;
    height: 14px;
  }

  .cart-upsells__add--loading {
    opacity: 0.7;
  }

  .cart-upsells__add--error {
    border-color: #c0392b;
    color: #c0392b;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Complementos del carrito",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Complementa tu regalo"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Máximo de productos",
      "min": 4,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
