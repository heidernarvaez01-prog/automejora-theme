

{% liquid
  assign image_url = section.settings.fallback_image | asset_url
  if section.settings.image != blank
    assign image_url = section.settings.image | image_url: width: 1600
  endif
%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div class="process-steps-section section spacing-style section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}" style="{% render 'spacing-style', settings: section.settings %}">
  {% if section.settings.heading != blank %}
    <h2 class="process-steps__heading">{{ section.settings.heading }}</h2>
  {% endif %}
  <div class="process-steps__media">
    <img
      src="{{ image_url }}"
      alt="{{ section.settings.alt | escape }}"
      loading="lazy"
      width="1516"
      height="182"
      class="process-steps__image"
    />
  </div>
</div>

{% stylesheet %}
  .process-steps-section {
    position: relative;
  }

  .process-steps__heading {
    text-align: center;
    font-family: var(--font-heading--family);
    font-weight: 600;
    font-size: 1.75rem;
    color: var(--color-foreground-heading);
    margin: 0 0 32px;
  }

  .process-steps__media {
    display: flex;
    justify-content: center;
  }

  .process-steps__image {
    width: 100%;
    max-width: 800px;
    height: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Cómo funciona",
  "tag": "section",
  "class": "process-steps-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "text",
      "id": "fallback_image",
      "label": "Imagen de respaldo (assets/)",
      "default": "process-steps-banner.webp"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Texto alternativo",
      "default": "Elige tu regalo, agrega una dedicatoria, escoge la fecha, indica la ubicación y recibe la entrega"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "Cómo funciona",
      "category": "t:categories.text"
    }
  ]
}
{% endschema %}
