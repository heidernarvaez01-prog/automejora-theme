

{% liquid
  assign wa_message = section.settings.message | url_encode
  assign wa_url = section.settings.phone | prepend: 'https://wa.me/' | append: '?text=' | append: wa_message
%}

<a
  href="{{ wa_url }}"
  target="_blank"
  rel="noopener noreferrer"
  class="floating-whatsapp"
  aria-label="{{ section.settings.aria_label | escape }}"
>
  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347Z"/>
    <path d="M12.04 2.003c-5.517 0-9.997 4.48-9.997 10.003 0 1.764.457 3.454 1.324 4.947L2 22l5.184-1.359a9.936 9.936 0 0 0 4.856 1.263h.004c5.517 0 9.997-4.48 9.997-10.003 0-2.672-1.04-5.184-2.928-7.073a9.935 9.935 0 0 0-7.073-2.828Zm0 18.187h-.003a8.28 8.28 0 0 1-4.223-1.156l-.303-.18-3.076.807.82-2.998-.198-.308a8.276 8.276 0 0 1-1.269-4.35c0-4.573 3.72-8.293 8.256-8.293a8.222 8.222 0 0 1 5.845 2.423 8.222 8.222 0 0 1 2.417 5.85c0 4.573-3.72 8.293-8.266 8.293Z"/>
  </svg>
</a>

{% stylesheet %}
  .floating-whatsapp {
    position: fixed;
    inset-block-end: max(20px, env(safe-area-inset-bottom));
    inset-inline-end: 20px;
    z-index: var(--layer-sticky);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background-color: #25d366;
    color: #fff;
    box-shadow: 0 6px 16px rgb(0 0 0 / 0.25);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .floating-whatsapp:hover {
    transform: scale(1.06);
    box-shadow: 0 8px 20px rgb(0 0 0 / 0.3);
  }

  .floating-whatsapp svg {
    width: 30px;
    height: 30px;
  }

  @media screen and (min-width: 750px) {
    .floating-whatsapp {
      inset-inline-end: 32px;
      inset-block-end: 32px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Botón flotante WhatsApp",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "phone",
      "label": "Teléfono (sin +, con código de país)",
      "default": "5215527137733"
    },
    {
      "type": "text",
      "id": "message",
      "label": "Mensaje predefinido",
      "default": "Hola Emociones a Domicilio, me gustaría más info."
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Etiqueta de accesibilidad",
      "default": "Chatea por WhatsApp"
    }
  ]
}
{% endschema %}
