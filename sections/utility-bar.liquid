

{% comment %}
  Top utility bar: contact info (phone / email) + social links.
  Meant to be placed in the header group, above the main header row.
{% endcomment %}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="utility-bar section spacing-style section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="utility-bar__row">
    <div class="utility-bar__contact">
      {% if section.settings.phone_number != blank %}
        <a href="{{ section.settings.phone_link }}" class="utility-bar__link">
          <span class="utility-bar__icon">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M4.5 3h2.7l1.2 3.6-1.7 1.2a9 9 0 0 0 4.7 4.7l1.2-1.7 3.6 1.2v2.7c0 .7-.6 1.3-1.3 1.2C8.9 15.4 4.6 11.1 4 5.3 3.9 4.6 4.5 3 4.5 3Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
            </svg>
          </span>
          {{ section.settings.phone_number }}
        </a>
      {% endif %}
      {% if section.settings.email != blank %}
        <a href="mailto:{{ section.settings.email }}" class="utility-bar__link">
          <span class="utility-bar__icon">
            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <rect x="3" y="4.5" width="14" height="11" rx="1.3" stroke="currentColor" stroke-width="1.3"/>
              <path d="m3.5 5.5 6.5 5 6.5-5" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
            </svg>
          </span>
          {{ section.settings.email }}
        </a>
      {% endif %}
    </div>

    {% liquid
      assign has_social = false
      if section.settings.whatsapp_url != blank or section.settings.instagram_url != blank or section.settings.facebook_url != blank or section.settings.tiktok_url != blank
        assign has_social = true
      endif
    %}
    {% if has_social %}
      <div class="utility-bar__social">
        <span class="utility-bar__social-label">{{ section.settings.social_label }}</span>
        {% if section.settings.whatsapp_url != blank %}
          <a href="{{ section.settings.whatsapp_url }}" class="utility-bar__social-icon" aria-label="WhatsApp" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 20 20" aria-hidden="true">{% render 'icon', icon: 'whatsapp' %}</svg>
          </a>
        {% endif %}
        {% if section.settings.instagram_url != blank %}
          <a href="{{ section.settings.instagram_url }}" class="utility-bar__social-icon" aria-label="Instagram" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 20 20" aria-hidden="true">{% render 'icon', icon: 'instagram' %}</svg>
          </a>
        {% endif %}
        {% if section.settings.facebook_url != blank %}
          <a href="{{ section.settings.facebook_url }}" class="utility-bar__social-icon" aria-label="Facebook" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 20 20" aria-hidden="true">{% render 'icon', icon: 'facebook' %}</svg>
          </a>
        {% endif %}
        {% if section.settings.tiktok_url != blank %}
          <a href="{{ section.settings.tiktok_url }}" class="utility-bar__social-icon" aria-label="TikTok" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 20 20" aria-hidden="true">{% render 'icon', icon: 'tiktok' %}</svg>
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .utility-bar {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .utility-bar {
      display: block;
    }
  }

  .utility-bar__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--gap-md);
    font-size: 0.75rem;
  }

  .utility-bar__contact {
    display: flex;
    align-items: center;
    gap: var(--gap-lg, 20px);
  }

  .utility-bar__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: currentColor;
    text-decoration: none;
    opacity: 0.9;
    transition: opacity var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .utility-bar__link:hover {
    opacity: 1;
    color: var(--color-primary-button-background);
  }

  .utility-bar__icon svg {
    width: 14px;
    height: 14px;
    display: block;
  }

  .utility-bar__social {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .utility-bar__social-label {
    opacity: 0.7;
  }

  .utility-bar__social-icon {
    display: flex;
    color: currentColor;
    opacity: 0.9;
    transition: opacity var(--animation-speed, 0.2s) var(--animation-easing, ease), transform var(--animation-speed, 0.2s) var(--animation-easing, ease);
  }

  .utility-bar__social-icon:hover {
    opacity: 1;
    color: var(--color-primary-button-background);
    transform: scale(1.1);
  }

  .utility-bar__social-icon svg {
    width: 15px;
    height: 15px;
    fill: currentColor;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Barra de contacto",
  "tag": "div",
  "class": "utility-bar-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Contacto"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Teléfono (texto mostrado)",
      "default": "+52 1 55 2713 7733"
    },
    {
      "type": "url",
      "id": "phone_link",
      "label": "Enlace del teléfono",
      "info": "Ej: https://wa.me/5215527137733"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Correo",
      "default": "pedidos@emocionesadomicilio.com"
    },
    {
      "type": "header",
      "content": "Redes sociales"
    },
    {
      "type": "text",
      "id": "social_label",
      "label": "Etiqueta",
      "default": "Síguenos:"
    },
    {
      "type": "url",
      "id": "whatsapp_url",
      "label": "WhatsApp"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok"
    },
    {
      "type": "header",
      "content": "Apariencia"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho",
      "options": [
        { "value": "page-width", "label": "Ancho de página" },
        { "value": "full-width", "label": "Ancho completo" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-5"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Superior",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Inferior",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 8
    }
  ]
}
{% endschema %}
